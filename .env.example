# ============================================================================
#  Per-client config. Copy this file to .env and fill it in for each client.
#  No source code changes are needed — everything below is read at runtime.
#  Two parts:  (A) BUSINESS DETAILS — quick to fill   (B) CREDENTIALS — per account
# ============================================================================


# ----------------------------------------------------------------------------
#  (A) BUSINESS DETAILS  —  the "just fill these" part
# ----------------------------------------------------------------------------
BUSINESS_NAME=                  # e.g. "Skyline Realty"

# Per-client knowledge injected into the agent's system prompt. Keep it short
# (projects, localities served, office address — anything the agent may state).
# The agent will NOT invent beyond this. Single line; use \n for line breaks.
BUSINESS_CONTEXT=               # e.g. "Projects: Skyline Heights (Wakad), Skyline Greens (Hinjewadi). Office: Baner Rd, Pune."

TIMEZONE=Asia/Kolkata
BUSINESS_HOURS=10:00-19:00      # local business time
WORKING_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
VISIT_DURATION_MIN=45
HUMAN_HANDOFF_NUMBER=           # owner's WhatsApp for escalations

# Project brochures the agent can send on WhatsApp (send_brochure tool).
# PRIMARY source is the CRM: brokers upload PDFs in the CRM Inventory page and
# the agent pulls the catalog from it (needs CRM_URL + CRM_BOT_TOKEN below).
# BROCHURES below is only a FALLBACK for standalone/no-CRM deploys — a JSON
# array; each url MUST be a PUBLIC direct-download PDF link (Meta fetches it),
# not a Drive "share" link. aliases/filename are optional. Leave blank to
# disable the fallback.
# BROCHURES=[{"project":"Skyline Heights","aliases":["skyline"],"url":"https://cdn.example.com/skyline-heights.pdf","filename":"Skyline Heights.pdf"}]
BROCHURES=

# Log verbosity for src/log.js (JSON lines to stdout/stderr).
LOG_LEVEL=info                  # error | warn | info | debug


# ----------------------------------------------------------------------------
#  (B) CREDENTIALS  —  one set per client account (cannot be skipped)
# ----------------------------------------------------------------------------

# --- WhatsApp Cloud API (client's Meta account) ---
WHATSAPP_TOKEN=                 # permanent access token
WHATSAPP_PHONE_NUMBER_ID=       # from Meta dashboard
WHATSAPP_VERIFY_TOKEN=          # any string; must match webhook setup
WHATSAPP_APP_SECRET=            # to verify X-Hub-Signature-256
GRAPH_API_VERSION=v23.0         # pin a CURRENT version; verify Meta docs

# --- Google Calendar (reached via the client's Apps Script web app) ---
GOOGLE_CALENDAR_ID=             # primary or a dedicated "Site Visits" calendar
APPS_SCRIPT_WEBAPP_URL=         # /exec URL of the deployed web app
APPS_SCRIPT_SHARED_SECRET=      # must match SHARED_SECRET Script Property

# --- Standard CRM (lead record + brochure catalog; blank = skip CRM sync) ---
CRM_URL=                        # base URL of the client's CRM deployment, e.g. https://crm.client.in
CRM_BOT_TOKEN=                  # must match WHATSAPP_BOT_TOKEN in the CRM's .env
SIMULATE_TOKEN=                 # bearer the CRM's Train page uses to hit /api/simulate

# --- AICredits / model (often your AGENCY's shared key, not per-client) ---
AICREDITS_API_KEY=sk-
AICREDITS_BASE_URL=https://api.aicredits.in/v1
MODEL=openai/gpt-4o-mini


# ----------------------------------------------------------------------------
#  Server
# ----------------------------------------------------------------------------
PORT=3000
